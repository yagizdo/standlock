    "Stand against a wall with your head, shoulders, and hips touching it. Hold this posture for 15 seconds." : {
      "comment" : "Exercise description",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Başınız, omuzlarınız ve kalçanız değecek şekilde duvara yaslanın. Bu duruşu 15 saniye koruyun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "背靠墙站立，让头部、肩膀和臀部都贴住墙面。保持这个姿势 15 秒。"
          }
        }
      }
    },
    "Stand and slowly rise onto your toes, then lower back down. Repeat 15 times." : {
      "comment" : "Exercise description",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayakta yavaşça parmak ucunuza yükselin, sonra inin. 15 kez tekrarlayın."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站立，缓慢踮起脚尖，然后落回。重复 15 次。"
          }
        }
      }
    },
    "Stand on one leg, grab your opposite foot behind you, and pull your heel toward your glute. Hold 15 seconds each side." : {
      "comment" : "Exercise description",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tek ayak üstünde durun, arkadan diğer ayağınızı tutup topuğunuzu kalçanıza doğru çekin. Her iki tarafta 15 saniye bekleyin."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "单腿站立，在身后抓住另一只脚，把脚跟拉向臀部。每侧保持 15 秒。"
          }
        }
      }
    },
    "Stand up and slowly bend forward to touch your toes. Hold for 10 seconds, then slowly rise back up." : {
      "comment" : "Exercise description",
      "extractionState" : "manual",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ayağa kalkıp yavaşça öne eğilerek parmak uçlarınıza dokunun. 10 saniye bekleyin, sonra yavaşça doğrulun."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "站起来，缓慢向前弯腰去触碰脚尖。保持 10 秒，然后慢慢起身。"
          }
        }
      }
    },
